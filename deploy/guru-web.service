[Unit]
Description=Guru web app (Next.js)
After=network.target postgresql.service ollama.service
Requires=postgresql.service ollama.service

[Service]
Type=simple
User=guru
Group=guru
WorkingDirectory=/srv/guru-web/current
# Split by trust boundary: NEXT_PUBLIC_* live in the public file (also
# read by deploy.sh at build time so they get inlined into client JS);
# secrets stay in the runtime-only file. systemd merges both.
EnvironmentFile=/etc/guru-web.public.env
EnvironmentFile=/etc/guru-web.env
# `current` symlinks to the release dir. `next start` resolves the build
# from .next/ relative to its CWD. PORT is read from /etc/guru-web.env.
# (Was `node server.js` when output: "standalone" was active — see
# deploy/deploy.sh "Bundler / output mode" comment for why we moved off
# standalone.)
ExecStart=/srv/guru-web/current/node_modules/.bin/next start
Restart=on-failure
RestartSec=5

# Hardening
# NOTE: MemoryDenyWriteExecute=true is intentionally OMITTED. V8's JIT compiler
# requires writable+executable memory pages (mprotect with PROT_WRITE|PROT_EXEC),
# which that directive blocks. With it set, Node panics at startup with
# "Check failed: 12 == errno" inside V8's MemoryAllocator. The other hardening
# directives below are JIT-safe.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/guru-web/current
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
